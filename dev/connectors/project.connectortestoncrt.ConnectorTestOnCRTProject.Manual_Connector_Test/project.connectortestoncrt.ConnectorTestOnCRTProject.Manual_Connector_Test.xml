<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<rest-connector xmlns="http://www.webmethods.com/cloudstreams/metadata/handler/model" id="project.connectortestoncrt.ConnectorTestOnCRTProject.Manual_Connector_Test" version="1.0" name="Manual_Connector_Test" displayName="Manual_Connector_Test">
    <description>Amku Test </description>
    <connections>
        <connection type="sagcloud" name="manualConnectorTestconnection" displayName="manualConnectorTestconnection">
            <groups>
                <group type="connection" name="connection" displayName="Connection">
                    <description>Define the required connection configurations to initiate communication with the SaaS provider.</description>
                    <fields>
                        <field isRequired="true" isEncrypted="false" isHidden="false" isArray="false" defaultValue="https://google.com" name="cn.providerUrl" displayName="Server URL">
